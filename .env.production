# Configuration production pour Vite et Electron

# API URL pour l'interface utilisateur
# En production (app installée), laisser vide pour auto-détection
# Le code apiConfig.js détectera automatiquement l'IP du serveur
# Permet aux clients réseau (LAN) de se connecter via http://IP_SERVEUR:3030
VITE_API_URL=

# Socket.IO - URL du serveur WebSocket (même que l'API)
# Laisser vide pour auto-détection basée sur window.location
VITE_SOCKET_URL=
