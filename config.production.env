# ============================================
# CONFIGURATION PRODUCTION - LA GRACE POS (.EXE)
# ============================================
# Ce fichier est utilisé en mode build/production
# Les chemins pointent vers %APPDATA%\Glowflixprojet

# ============================================
# CHEMINS PRODUCTION (AppData)
# ============================================

# Répertoire racine (remplacé dynamiquement par Electron)
# LAGRACE_DATA_DIR sera défini par Electron au démarrage
# Si non défini, l'app utilisera %APPDATA%\Glowflixprojet

# Mode production
NODE_ENV=production

# ============================================
# SERVEUR ET RÉSEAU
# ============================================
PORT=3030
APP_BASE_URL=http://localhost:3030
HOST=0.0.0.0

# ============================================
# GOOGLE SHEETS SYNCHRONISATION
# ============================================
GOOGLE_SHEETS_SPREADSHEET_ID=111HH1yCU1gB5Uovbcach_Olz1e3hL4-J0z8QGHoOEtI
GOOGLE_SHEETS_WEBAPP_URL=https://script.google.com/macros/s/AKfycbwG0kGRU5R_ffD7t9LPCzECH56jVbkqifW3Rjl7AID9wMaiFRQyiHJp4K0ncOfHaaSONA/exec
SYNC_INTERVAL_MS=10000
SYNC_AUTO_ENABLED=1

# ============================================
# IMPRESSION (Configuration Production)
# ============================================
PRINTER_NAME=
PRINT_DEFAULT_TEMPLATE=receipt-80
PRINT_FORCE_DEFAULT=1
PRINT_MAX_RETRY=3
PRINT_RETRY_DELAYS=2000,5000,10000
PRINT_GUARDIAN_AUTO=1

# ============================================
# LOGS
# ============================================
LOG_LEVEL=info
SYNC_LOG_ENABLED=1
PRINT_LOG_ENABLED=1

# ============================================
# ENTREPRISE
# ============================================
COMPANY_NAME=ALIMENTATION LA GRACE
COMPANY_RCCM=CD/KIS/RCCM 22-A-00172
COMPANY_IMPOT=A220883T
COMPANY_PHONE=+243 896 885 373 / +243 819 082 637
COMPANY_ADDRESS=Avenue Lac Tanganyika, Makiso, Kisangani, R.D.Congo

# ============================================
# TAUX DE CHANGE
# ============================================
DEFAULT_EXCHANGE_RATE=2800

# ============================================
# SÉCURITÉ
# ============================================
JWT_SECRET=lagrace-pos-secret-key-2024-production
JWT_EXPIRES_IN=86400

