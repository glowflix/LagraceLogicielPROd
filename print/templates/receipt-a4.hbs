<!DOCTYPE html>
<html>
<head>
  <meta charset="utf-8" />
  <title>Facture {{factureNum}}</title>
  <style>
    * {
      margin: 0;
      padding: 0;
      box-sizing: border-box;
    }
    
    body {
      font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
      font-size: 10pt;
      line-height: 1.2;
      color: #333;
      padding: 10mm;
      background: white;
    }
    
    .container {
      max-width: 210mm;
      margin: 0 auto;
    }
    
    /* En-tête */
    .header {
      margin-bottom: 8mm;
      border-bottom: 2px solid #000;
      padding-bottom: 5mm;
    }
    
    .company-name {
      font-size: 14pt;
      font-weight: bold;
      margin-bottom: 2mm;
    }
    
    .company-info {
      font-size: 9pt;
      line-height: 1.3;
    }
    
    .invoice-title {
      font-size: 12pt;
      font-weight: bold;
      margin-top: 3mm;
    }
    
    /* Section facture */
    .invoice-details {
      display: flex;
      justify-content: space-between;
      margin-bottom: 6mm;
      font-size: 9pt;
    }
    
    .detail-col {
      flex: 1;
    }
    
    .detail-col strong {
      display: block;
      font-weight: bold;
      margin-bottom: 1mm;
    }
    
    /* Tableau */
    table {
      width: 100%;
      border-collapse: collapse;
      margin-bottom: 6mm;
      font-size: 9pt;
    }
    
    thead {
      background-color: #f5f5f5;
      font-weight: bold;
    }
    
    th {
      padding: 3mm 2mm;
      text-align: left;
      border-bottom: 1pt solid #000;
    }
    
    td {
      padding: 2mm;
      border-bottom: 1pt solid #ddd;
    }
    
    tfoot td {
      font-weight: bold;
      border-top: 2pt solid #000;
      border-bottom: 2pt solid #000;
      padding: 3mm 2mm;
    }
    
    .text-right {
      text-align: right;
    }
    
    /* ✅ FIX PRO: Fractions en petit (1/2, 1/4, 3/4, 1/3, etc.) */
    .qty-badge{ display:inline-flex; flex-wrap:wrap; align-items:center; gap:2px; }
    .qty-badge .q{ font-weight:700; }
    .qty-badge .q-int{ font-weight:800; }
    .qty-badge .q-frac{ font-weight:800; font-size:0.78em; }
    .qty-badge .mk{ font-weight:700; font-size:0.9em; margin-left:2px; }
    .qty-badge .mk-txt{ font-weight:700; }
    
    .total-section {
      margin-top: 8mm;
      padding-top: 4mm;
      border-top: 1pt solid #000;
      font-weight: bold;
      font-size: 11pt;
    }
    
    .footer {
      margin-top: 10mm;
      padding-top: 5mm;
      border-top: 1pt solid #ccc;
      font-size: 8pt;
      text-align: center;
      color: #666;
      line-height: 1.4;
    }
    
    @media print {
      body {
        padding: 5mm;
      }
    }
  </style>
</head>
<body>
  <div class="container">
    <!-- En-tête -->
    <div class="header">
      <div class="company-name">{{#if entreprise}}{{entreprise.nom}}{{else}}ALIMENTATION LA GRACE{{/if}}</div>
      <div class="company-info">
        {{#if entreprise}}
          {{#if entreprise.rccm}}RCCM: {{entreprise.rccm}}<br>{{/if}}
          {{#if entreprise.impot}}Impôt: {{entreprise.impot}}<br>{{/if}}
          {{#if entreprise.tel}}Tel: {{entreprise.tel}}<br>{{/if}}
        {{/if}}
      </div>
      <div class="invoice-title">FACTURE N° {{factureNum}}</div>
    </div>
    
    <!-- Détails de la facture -->
    <div class="invoice-details">
      <div class="detail-col">
        <strong>Client:</strong> {{client}}<br>
        <strong>Date:</strong> {{dateISO}}
      </div>
      <div class="detail-col text-right">
        <strong>Taux:</strong> {{taux}} FC/USD<br>
        <strong>Devise:</strong> {{printCurrency}}
      </div>
    </div>
    
    <!-- Tableau articles -->
    <table>
      <thead>
        <tr>
          <th>Code</th>
          <th>Désignation</th>
          <th>Unité</th>
          <th class="text-right">Qty</th>
          <th class="text-right">PU</th>
          <th class="text-right">Total</th>
        </tr>
      </thead>
      <tbody>
        {{#each lignes}}
          <tr>
            <td>{{code}}</td>
            <td>{{nom}}</td>
            <td>{{unite}}{{#if mark}} ({{mark}}){{/if}}</td>
            <td class="text-right">{{#if displayQteHtml}}{{{displayQteHtml}}}{{else}}{{qty}}{{/if}}</td>
            <td class="text-right">{{puFC}}</td>
            <td class="text-right">{{totalFC}}</td>
          </tr>
        {{/each}}
      </tbody>
      <tfoot>
        <tr>
          <td colspan="5" class="text-right">TOTAL FC:</td>
          <td class="text-right">{{totalFC}}</td>
        </tr>
        {{#if totalUSD}}
          <tr>
            <td colspan="5" class="text-right">TOTAL USD:</td>
            <td class="text-right">{{totalUSD}}</td>
          </tr>
        {{/if}}
      </tfoot>
    </table>
    
    <!-- Pied de page -->
    <div class="footer">
      Merci de votre achat<br>
      {{#if entreprise}}{{#if entreprise.adresse}}{{entreprise.adresse}}<br>{{/if}}{{/if}}
      Facture imprimée automatiquement
    </div>
  </div>
</body>
</html>
  